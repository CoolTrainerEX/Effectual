:root {
    background-image: url("project://database/Assets/Images/Background.PNG?fileID=21300000&guid=adfa48c3f6a83984f8d3885774ca16c6&type=3#Background");
    -unity-background-scale-mode: scale-and-crop;
}

#title {
    font-size: 64px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(255, 127, 41);
    flex-direction: row;
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    justify-content: center;
    -unity-text-align: middle-center;
    height: 50%;
    color: rgb(255, 255, 255);
}